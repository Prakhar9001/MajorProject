rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{patientId} {
      allow read, write: if request.auth != null && request.auth.uid == patientId;
      
      match /timeline/{timelineId} {
         allow read, write: if request.auth != null && request.auth.uid == patientId;
      }
    }
  }
}
